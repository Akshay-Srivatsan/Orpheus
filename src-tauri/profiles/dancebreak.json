 "announcements": [
  "No street shoes on the dance floor \u2014 dance shoes or socks only.",
  "Remember to sign in on the piano!",
  "Pizza is in the lobby.",
  "Jam! Come to the middle if you have something to celebrate."
 ],
 "rules": [
  {
   "type": "songCount",
   "min": 30,
   "max": 35,
   "severity": "warning",
   "label": "30\u201335 songs in a 2-hour social"
  },
  {
   "type": "styleInFirst",
   "target": "@lesson",
   "n": 5,
   "min": 2,
   "label": "At least 2 of the first 5 songs are the lesson style"
  },
  {
   "type": "maxDuration",
   "seconds": 210,
   "from": 1,
   "to": 10,
   "label": "First 10 songs under 3:30"
  },
  {
   "type": "maxDuration",
   "seconds": 270,
   "from": 11,
   "label": "Remaining songs under 4:30"
  },
  {
   "type": "styleCount",
   "target": "@lesson",
   "min": {
    "waltz": 7,
    "swing": 7,
    "other": 5
   },
   "label": "Lesson style"
  },
  {
   "type": "tagCount",
   "tag": "dance-with-stranger",
   "target": "@lesson",
   "half": "first",
   "min": 1,
   "label": "1 Dance with a Stranger (lesson style) in the first half"
  },
  {
   "type": "styleCount",
   "target": "cross-step-waltz",
   "min": {
    "waltz": 9,
    "swing": 8,
    "other": 8
   },
   "label": "Cross-step waltzes"
  },
  {
   "type": "tagCount",
   "tag": "jam",
   "target": "cross-step-waltz",
   "half": "second",
   "min": 1,
   "label": "1 Jam (cross-step) in the second half"
  },
  {
   "type": "styleCount",
   "target": "group:rotary",
   "min": {
    "waltz": 7,
    "swing": 6,
    "other": 6
   },
   "label": "Rotary waltzes"
  },
  {
   "type": "styleCount",
   "target": "fast-waltz",
   "max": 3,
   "label": "No more than 3 fast/accelerating waltzes"
  },
  {
   "type": "styleCount",
   "target": "lindy-hop",
   "min": {
    "waltz": 4,
    "swing": 4,
    "other": 3
   },
   "label": "Lindy Hop"
  },
  {
   "type": "styleCount",
   "target": "west-coast-swing",
   "min": {
    "waltz": 4,
    "swing": 4,
    "other": 3
   },
   "label": "West Coast Swing"
  },
  {
   "type": "styleCount",
   "target": "polka",
   "min": 1,
   "label": "Polka"
  },
  {
   "type": "styleCount",
   "target": "group:fusion",
   "min": 1,
   "label": "Fusion"
  },
  {
   "type": "styleCount",
   "target": "group:latin",
   "min": 1,
   "label": "Latin"
  },
  {
   "type": "styleCount",
   "target": "group:line",
   "min": 1,
   "label": "Line dance"
  },
  {
   "type": "styleCount",
   "target": "group:mixer",
   "min": 1,
   "label": "Mixer"
  },
  {
   "type": "styleCount",
   "target": "group:choreo",
   "min": 1,
   "label": "Choreography (BNP etc.)"
  },
  {
   "type": "styleCount",
   "target": "group:extra",
   "max": 4,
   "label": "Additional non-core styles (max 4)"
  },
  {
   "type": "tempoRange",
   "range": "extended",
   "maxExceptions": 6,
   "notInFirst": 10,
   "noConsecutive": true,
   "label": "Tempo within range (0\u20136 exceptions, not consecutive, not in first 10)"
  },
  {
   "type": "endingSequence",
   "sequence": [
    "west-coast-swing",
    "lindy-hop",
    "cross-step-waltz",
    "rotary-waltz"
   ],
   "flexibleCount": 3,
   "allowAfter": [
    "solo-jazz"
   ],
   "label": "Ends with Last WCS, Lindy, Cross-Step (any order), then Last Rotary Waltz"
  },
  {
   "type": "noRepeat",
   "severity": "warning",
   "label": "No song played twice"
  },
  {
   "type": "noConsecutiveSame",
   "tempoPct": 5,
   "severity": "warning",
   "label": "No two consecutive songs of the same style at the same tempo"
  }
 ]
}