 "rules": [
  {
   "type": "maxDuration",
   "seconds": 210,
   "from": 1,
   "severity": "warning",
   "label": "Aim for ~3-minute songs (flag over 3:30)"
  },
  {
   "type": "tempoRange",
   "range": "extended",
   "severity": "warning",
   "label": "Tempo within \u00b110% of the sweet spot"
  },
  {
   "type": "noConsecutiveSame",
   "tempoPct": 5,
   "severity": "warning",
   "label": "No two consecutive songs of the same dance at the same tempo"
  },
  {
   "type": "maxConsecutive",
   "energy": "fast",
   "count": 2,
   "severity": "warning",
   "label": "No more than 2 very fast songs in a row"
  },
  {
   "type": "maxConsecutive",
   "energy": "slow",
   "count": 3,
   "severity": "warning",
   "label": "No more than 3 slow songs in a row"
  },
  {
   "type": "noRepeat",
   "severity": "warning",
   "label": "No song played twice"
  }
 ]
