{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orpheus",
  "version": "0.1.0",
  "identifier": "edu.stanford.orpheus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orpheus",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "url": "index.html",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
